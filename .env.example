# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Google Cloud key, restricted to the Fact Check Tools API (works without billing)
GOOGLE_API_KEY=
# Reverse image search (SerpApi Google Lens), free plan: 250 searches a month
SERPAPI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: AI-generated image signal
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
