# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Google Cloud key, restricted to the Fact Check Tools API (works without billing)
GOOGLE_API_KEY=
# Reverse image search (SerpApi Google Lens), free plan: 250 searches a month
SERPAPI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The team's demo pass: opening /api/demo-pass?secret=<this> sets a cookie that skips the rate limits.
# Long and random (e.g. `openssl rand -hex 16`); share it with the team only.
DEMO_PASS_SECRET=
